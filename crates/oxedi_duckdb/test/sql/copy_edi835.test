# The envelope comes from the options.

query T
SELECT content[1:106] FROM read_text('__TEST_DIR__/copy_ref.835');
----
ISA*00*          *00*          *ZZ*SENDER         *ZZ*RECEIVER       *240102*1030*^*00501*000000001*0*P*:~

query T
SELECT content[1:106] FROM read_text('__TEST_DIR__/copy_4010.835');
----
ISA*00*          *00*          *ZZ*SENDER         *ZZ*RECEIVER       *240102*1030*U*00401*000000001*0*P*:~

# The time option takes a TIME_NS as well.

statement ok
COPY (SELECT * FROM tables_5010) TO '__TEST_DIR__/copy_time_ns.835'
    (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time TIME_NS '10:30:15');

query I
SELECT contains(content, 'GS*HP*SENDER*RECEIVER*20240102*103015*1*X*') FROM read_text('__TEST_DIR__/copy_time_ns.835');
----
true

# Every option reaches the envelope; a bare line_break means true.

statement ok
COPY (SELECT * FROM tables_5010) TO '__TEST_DIR__/copy_options.835'
    (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date DATE '2024-01-02',
     time TIME '10:30:15', sender_qualifier '01', receiver_qualifier '14', usage_indicator 'T',
     control_number 42, application_sender 'APPS', application_receiver 'APPR',
     delimiters {'element': '|', 'component': '>', 'segment': '~', 'repetition': '^'}, line_break);

query T
SELECT unnest(string_split(content, chr(10))[1:2]) FROM read_text('__TEST_DIR__/copy_options.835');
----
ISA|00|          |00|          |01|SENDER         |14|RECEIVER       |240102|1030|^|00501|000000042|0|T|>~
GS|HP|APPS|APPR|20240102|103015|42|X|005010X221A1~

