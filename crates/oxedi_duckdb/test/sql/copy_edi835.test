# ---- sources: a view (above), a TEMP table, several rows, the caller's open transaction ----

statement ok
CREATE TEMP TABLE temp_tables AS SELECT * FROM tables_5010;

statement ok
COPY temp_tables TO '__TEST_DIR__/copy_temp.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30');

query I
SELECT (SELECT md5(content) FROM read_blob('__TEST_DIR__/copy_ref.835')) = (SELECT md5(content) FROM read_blob('__TEST_DIR__/copy_temp.835'));
----
true

# Several rows concatenate each table's lists in order; a NULL list adds nothing.

statement ok
COPY (
    SELECT {'payments': payments, 'claims': claims, 'services': services, 'adjustments': adjustments,
            'provider_adjustments': provider_adjustments} FROM (
        SELECT payments, list_slice(claims, 1, 2) AS claims, services, adjustments,
               provider_adjustments
        FROM parts_5010
        UNION ALL
        SELECT NULL, list_slice(claims, 3, 4), NULL, NULL, NULL FROM parts_5010
    )
) TO '__TEST_DIR__/copy_rows.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30', preserve_order true);

query I
SELECT (SELECT md5(content) FROM read_blob('__TEST_DIR__/copy_ref.835')) = (SELECT md5(content) FROM read_blob('__TEST_DIR__/copy_rows.835'));
----
true

statement ok
BEGIN TRANSACTION;

statement ok
CREATE TABLE open_tables AS SELECT * FROM tables_5010;

statement ok
COPY open_tables TO '__TEST_DIR__/copy_transaction.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30');

statement ok
ROLLBACK;

query I
SELECT (SELECT md5(content) FROM read_blob('__TEST_DIR__/copy_ref.835')) = (SELECT md5(content) FROM read_blob('__TEST_DIR__/copy_transaction.835'));
----
true

# ---- input shapes: empty and NULL lists, NULL structs and fields, a table left out ----

# A NULL struct adds no row; an empty list and a NULL list add none either.

statement ok
COPY (
    SELECT {'payments': payments, 'claims': claims, 'services': services, 'adjustments': adjustments,
            'provider_adjustments': provider_adjustments} FROM (
        SELECT payments, list_concat(claims, [NULL]) AS claims, services, adjustments,
               provider_adjustments
        FROM parts_5010
        UNION ALL
        SELECT [], NULL, [], NULL, [] FROM parts_5010
    )
) TO '__TEST_DIR__/copy_nulls.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30', preserve_order true);

query I
SELECT (SELECT md5(content) FROM read_blob('__TEST_DIR__/copy_ref.835')) = (SELECT md5(content) FROM read_blob('__TEST_DIR__/copy_nulls.835'));
----
true

# A NULL input row adds nothing either.

statement ok
COPY (SELECT * FROM tables_5010 UNION ALL SELECT NULL)
TO '__TEST_DIR__/copy_null_row.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30', preserve_order true);

query I
SELECT (SELECT md5(content) FROM read_blob('__TEST_DIR__/copy_ref.835')) = (SELECT md5(content) FROM read_blob('__TEST_DIR__/copy_null_row.835'));
----
true

# A table left out has no rows: without its provider adjustments the payment no longer balances.

statement error
COPY (
    SELECT {'payments': payments, 'claims': claims, 'services': services, 'adjustments': adjustments} FROM (
        SELECT payments, claims, services, adjustments FROM parts_5010
    )
) TO '__TEST_DIR__/copy_left_out.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30');
----
edi835: the tables do not make a valid file (1 finding); nothing was written
1. table "payments" row 0 column "total_payment_amount": SNIP 3 · balancing rule "transaction_balance" fails in loop "transaction" opened at segment #2: BPR02 of transaction "financial_information" is 690.00, but sum of CLP04 of 2100 "claim_payment_information" - sum of PLB04, PLB06, PLB08, PLB10, PLB12, PLB14 of transaction "provider_adjustment" adds up to 720.00 (off by -30.00); read from segments #3, #15, #34, #45, #52 · segment #3, element 2 · at interchange#1/group#1/transaction#1 · datum "690"

# A NULL field is a null cell; a field left out is a null column. A null in the middle of a
# segment is written as an empty element, which reads back as empty text.

statement ok
COPY (
    SELECT {'payments': payments, 'claims': claims, 'services': services, 'adjustments': adjustments, 'provider_adjustments': provider_adjustments} FROM (
        SELECT payments,
               list_transform(claims, lambda c: struct_update(c, rendering_provider_name := NULL::VARCHAR)) AS claims,
               services, adjustments, provider_adjustments
        FROM parts_5010
    )
) TO '__TEST_DIR__/copy_null_field.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30');

query I
SELECT count(NULLIF(rendering_provider_name, '')) FROM read_835('__TEST_DIR__/copy_null_field.835');
----
0

statement ok
COPY (
    SELECT {'payments': payments, 'claims': claims, 'services': services, 'adjustments': adjustments, 'provider_adjustments': provider_adjustments} FROM (
        SELECT payments,
               (SELECT list(c ORDER BY c."row")
                FROM (SELECT * EXCLUDE (rendering_provider_entity_type, rendering_provider_id,
                                        rendering_provider_id_qualifier, rendering_provider_name)
                      FROM read_835('../oxedi_core/tests/fixtures/balanced_5010_sample.txt')) c) AS claims,
               services, adjustments, provider_adjustments
        FROM parts_5010
    )
) TO '__TEST_DIR__/copy_few_fields.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30');

query TII
SELECT claim_id, count(rendering_provider_id), count(rendering_provider_name)
FROM read_835('__TEST_DIR__/copy_few_fields.835') GROUP BY claim_id ORDER BY claim_id;
----
CLM1001	0	0
CLM1002	0	0
CLM2001	0	0
CLM2002	0	0

# ---- input types: other widths, scales and text types (ENUM too) write the same file ----

statement ok
COPY (
    SELECT {'payments': payments, 'claims': claims, 'services': services, 'adjustments': adjustments, 'provider_adjustments': provider_adjustments} FROM (
        SELECT payments,
               list_transform(claims, lambda c: struct_update(c,
                   "row" := c."row"::INTEGER,
                   payment := c.payment::HUGEINT,
                   claim_id := c.claim_id::BLOB,
                   claim_status := c.claim_status::ENUM('1', '2', '4'),
                   charge_amount := c.charge_amount::DECIMAL(18, 3),
                   payment_amount := c.payment_amount::DECIMAL(9, 2),
                   statement_from := c.statement_from::TIMESTAMP)) AS claims,
               list_transform(services, lambda s: struct_update(s,
                   "row" := s."row"::UTINYINT,
                   claim := s.claim::DOUBLE)) AS services,
               adjustments, provider_adjustments
        FROM parts_5010
    )
) TO '__TEST_DIR__/copy_types.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30');

query I
SELECT (SELECT md5(content) FROM read_blob('__TEST_DIR__/copy_ref.835')) = (SELECT md5(content) FROM read_blob('__TEST_DIR__/copy_types.835'));
----
true

# A value that would change is refused with its table, column and row.

statement error
COPY (
    SELECT {'payments': payments, 'claims': claims} FROM (
        SELECT payments,
               list_transform(claims, lambda c: struct_update(c,
                   charge_amount := c.charge_amount::DECIMAL(18, 3) + 0.001)) AS claims
        FROM parts_5010
    )
) TO '__TEST_DIR__/copy_value.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30');
----
edi835: table "claims" column "charge_amount" row 0: 300001 at scale 3 has more decimals than the column's scale 2

statement error
COPY (
    SELECT {'payments': payments, 'claims': claims} FROM (
        SELECT payments,
               list_transform(claims, lambda c: struct_update(c,
                   statement_from := c.statement_from::TIMESTAMP + INTERVAL 1 HOUR)) AS claims
        FROM parts_5010
    )
) TO '__TEST_DIR__/copy_value.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30');
----
edi835: table "claims" column "statement_from" row 0: timestamp 1704416400000000 is not at midnight; give dates

statement error
COPY (
    SELECT {'payments': payments, 'claims': claims} FROM (
        SELECT payments,
               list_transform(claims, lambda c: struct_update(c, payment := c.payment::HUGEINT + 9223372036854775808))
                   AS claims
        FROM parts_5010
    )
) TO '__TEST_DIR__/copy_value.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30');
----
edi835: table "claims" column "payment" row 0: 9223372036854775808 does not fit a 64-bit integer

query I
SELECT count(*) FROM glob('__TEST_DIR__/copy_value.835');
----
0

# ---- strict: any finding fails the COPY with the full listing, and nothing is written ----

statement error
COPY (SELECT * FROM tables_multi) TO '__TEST_DIR__/copy_refused.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30');
----
edi835: the tables do not make a valid file (5 findings); nothing was written
1. table "services" row 0 column "procedure_qualifier" writes SVC01-1 with "HC:99213", which holds the component separator ":"; a value cannot hold the interchange's delimiters
2. table "services" row 1 column "procedure_qualifier" writes SVC01-1 with "HC:99214", which holds the component separator ":"; a value cannot hold the interchange's delimiters
3. table "services" row 2 column "procedure_qualifier" writes SVC01-1 with "HC:99213", which holds the component separator ":"; a value cannot hold the interchange's delimiters
