query I
SELECT count(*) FROM glob('__TEST_DIR__/copy_refused.835');
----
0

# The writer's own refusals read as in Python: here the delimiters leave out the repetition
# separator the 5010 interchange header carries.

statement error
COPY (SELECT * FROM tables_5010) TO '__TEST_DIR__/copy_refused.835'
    (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30', delimiters {'element': '|'});
----
edi835: the interchange header carries a repetition separator, but the envelope field "delimiters.repetition" is not set

# ---- the target file ----

# A refusal leaves an existing file as it was.

statement ok
COPY (SELECT * FROM tables_5010) TO '__TEST_DIR__/copy_kept.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30');

statement error
COPY (SELECT * FROM tables_multi) TO '__TEST_DIR__/copy_kept.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30');
----
edi835: the tables do not make a valid file (5 findings); nothing was written

query I
SELECT (SELECT md5(content) FROM read_blob('__TEST_DIR__/copy_ref.835')) = (SELECT md5(content) FROM read_blob('__TEST_DIR__/copy_kept.835'));
----
true

# A successful COPY replaces an existing file whole (DuckDB writes a temporary file and moves it).

statement ok
COPY (SELECT * FROM tables_4010) TO '__TEST_DIR__/copy_kept.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30', version '4010');

query I
SELECT (SELECT md5(content) FROM read_blob('__TEST_DIR__/copy_4010.835')) = (SELECT md5(content) FROM read_blob('__TEST_DIR__/copy_kept.835'));
----
true

# Without the temporary file (USE_TMP_FILE false, or a remote path) the file is written from its
# first byte: an existing file no longer than the new content is replaced whole.

statement ok
COPY (SELECT * FROM tables_5010) TO '__TEST_DIR__/copy_kept.835'
    (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30', use_tmp_file false);

query I
SELECT (SELECT md5(content) FROM read_blob('__TEST_DIR__/copy_ref.835')) = (SELECT md5(content) FROM read_blob('__TEST_DIR__/copy_kept.835'));
----
true

# A longer one cannot be truncated through the C API, so it is refused. What DuckDB then does
# with the target of the failed COPY depends on its version.

statement error
COPY (SELECT * FROM tables_4010) TO '__TEST_DIR__/copy_kept.835'
    (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30', version '4010', use_tmp_file false);
----
<REGEX>:.*edi835: ".*copy_kept\.835" could not be opened for writing: it already holds 1450 bytes, more than the 1404 to write, and DuckDB's file system cannot truncate a file from an extension; remove it first, or leave USE_TMP_FILE at its default.*

statement error
COPY (SELECT * FROM tables_5010) TO '__TEST_DIR__/no_such_directory/out.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30');
----
<REGEX>:.*edi835: ".*no_such_directory/out\.835" could not be opened for writing: .*

# One file per COPY: DuckDB handles PARTITION_BY and PER_THREAD_OUTPUT before the format sees
# them, so the format refuses the second file DuckDB asks for. Output that makes a single file
# (one partition, one thread) is not detected. DuckDB removes the partition files it created; with
# PER_THREAD_OUTPUT the file written before the refusal stays.

statement error
COPY (SELECT 1 AS part, * FROM tables_5010 UNION ALL SELECT 2, * FROM tables_5010)
TO '__TEST_DIR__/copy_parts.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30', partition_by (part), overwrite true);
----
<REGEX>:.*edi835: the COPY asks for a second file, ".*copy_parts\.835.*part=\d+.*", but the format writes all the rows as one interchange in one file; PARTITION_BY and PER_THREAD_OUTPUT do not apply.*

query I
SELECT count(*) FROM glob('__TEST_DIR__/copy_parts.835/*/*');
----
0

statement error
COPY (SELECT * FROM tables_5010 UNION ALL SELECT * FROM tables_5010)
TO '__TEST_DIR__/copy_threads.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30', per_thread_output true, overwrite true);
----
<REGEX>:.*edi835: the COPY asks for a second file, ".*copy_threads\.835.*", but the format writes all the rows as one interchange in one file; PARTITION_BY and PER_THREAD_OUTPUT do not apply.*
