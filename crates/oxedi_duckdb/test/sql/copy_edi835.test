# name: test/sql/copy_edi835.test
# description: COPY ... (FORMAT edi835) writes the tables back into an 835: round trips of a 5010
#              and a 4010 fixture, the sources a query can read (view, TEMP table, several rows,
#              the open transaction), input shapes and types, refusals, and the target file;
#              the input is one STRUCT column keyed by table
# group: [oxedi]

require oxedi

statement ok
CREATE VIEW parts_5010 AS
SELECT (SELECT list(t ORDER BY t."row") FROM read_835('../oxedi_core/tests/fixtures/balanced_5010_sample.txt', table_name := 'payments') t) AS payments,
       (SELECT list(t ORDER BY t."row") FROM read_835('../oxedi_core/tests/fixtures/balanced_5010_sample.txt', table_name := 'claims') t) AS claims,
       (SELECT list(t ORDER BY t."row") FROM read_835('../oxedi_core/tests/fixtures/balanced_5010_sample.txt', table_name := 'services') t) AS services,
       (SELECT list(t ORDER BY t."row") FROM read_835('../oxedi_core/tests/fixtures/balanced_5010_sample.txt', table_name := 'adjustments') t) AS adjustments,
       (SELECT list(t ORDER BY t."row") FROM read_835('../oxedi_core/tests/fixtures/balanced_5010_sample.txt', table_name := 'provider_adjustments') t) AS provider_adjustments;

statement ok
CREATE VIEW parts_4010 AS
SELECT (SELECT list(t ORDER BY t."row") FROM read_835('../oxedi_core/tests/fixtures/balanced_4010_sample.txt', table_name := 'payments') t) AS payments,
       (SELECT list(t ORDER BY t."row") FROM read_835('../oxedi_core/tests/fixtures/balanced_4010_sample.txt', table_name := 'claims') t) AS claims,
       (SELECT list(t ORDER BY t."row") FROM read_835('../oxedi_core/tests/fixtures/balanced_4010_sample.txt', table_name := 'services') t) AS services,
       (SELECT list(t ORDER BY t."row") FROM read_835('../oxedi_core/tests/fixtures/balanced_4010_sample.txt', table_name := 'adjustments') t) AS adjustments,
       (SELECT list(t ORDER BY t."row") FROM read_835('../oxedi_core/tests/fixtures/balanced_4010_sample.txt', table_name := 'provider_adjustments') t) AS provider_adjustments;

statement ok
CREATE VIEW parts_multi AS
SELECT (SELECT list(t ORDER BY t."row") FROM read_835('../oxedi_core/tests/fixtures/multi_claim_sample.txt', table_name := 'payments') t) AS payments,
       (SELECT list(t ORDER BY t."row") FROM read_835('../oxedi_core/tests/fixtures/multi_claim_sample.txt', table_name := 'claims') t) AS claims,
       (SELECT list(t ORDER BY t."row") FROM read_835('../oxedi_core/tests/fixtures/multi_claim_sample.txt', table_name := 'services') t) AS services,
       (SELECT list(t ORDER BY t."row") FROM read_835('../oxedi_core/tests/fixtures/multi_claim_sample.txt', table_name := 'adjustments') t) AS adjustments,
       (SELECT list(t ORDER BY t."row") FROM read_835('../oxedi_core/tests/fixtures/multi_claim_sample.txt', table_name := 'provider_adjustments') t) AS provider_adjustments;

# The input: one STRUCT column keyed by table, each field a list of that table's rows.

statement ok
CREATE VIEW tables_5010 AS SELECT {'payments': payments, 'claims': claims, 'services': services, 'adjustments': adjustments, 'provider_adjustments': provider_adjustments} AS tables FROM parts_5010;

statement ok
CREATE VIEW tables_4010 AS SELECT {'payments': payments, 'claims': claims, 'services': services, 'adjustments': adjustments, 'provider_adjustments': provider_adjustments} AS tables FROM parts_4010;

statement ok
CREATE VIEW tables_multi AS SELECT {'payments': payments, 'claims': claims, 'services': services, 'adjustments': adjustments, 'provider_adjustments': provider_adjustments} AS tables FROM parts_multi;

# ---- round trips: read_835 -> COPY -> read_835 gives the same tables, apart from segment ----

statement ok
COPY (SELECT * FROM tables_5010) TO '__TEST_DIR__/copy_ref.835' (FORMAT edi835, sender_id 'SENDER', receiver_id 'RECEIVER', date '2024-01-02', time '10:30');

query I
SELECT count(*) FROM (
    (SELECT * EXCLUDE (segment) FROM read_835('../oxedi_core/tests/fixtures/balanced_5010_sample.txt', table_name := 'payments')
     EXCEPT ALL
     SELECT * EXCLUDE (segment) FROM read_835('__TEST_DIR__/copy_ref.835', table_name := 'payments'))
    UNION ALL
    (SELECT * EXCLUDE (segment) FROM read_835('__TEST_DIR__/copy_ref.835', table_name := 'payments')
     EXCEPT ALL
     SELECT * EXCLUDE (segment) FROM read_835('../oxedi_core/tests/fixtures/balanced_5010_sample.txt', table_name := 'payments')));
----
0

