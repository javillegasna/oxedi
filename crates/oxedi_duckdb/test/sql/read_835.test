# name: test/sql/read_835.test
# description: the extension loads and read_835 reads one fixture's claims
# group: [oxedi]

require oxedi

query I
SELECT count(*) FROM read_835('../edi835_core/tests/fixtures/multi_claim_sample.txt');
----
2

query TRR
SELECT claim_id, charge_amount, payment_amount
FROM read_835('../edi835_core/tests/fixtures/multi_claim_sample.txt')
ORDER BY "row";
----
33344555510	800.00	500.00
44455666610	1200.00	600.00
