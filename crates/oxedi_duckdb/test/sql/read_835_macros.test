# name: test/sql/read_835_macros.test
# description: read_835 inside table macros: a macro parameter forwarded to table_name or version
# group: [oxedi]

require oxedi

# A bare macro parameter given with := is substituted by newer DuckDB versions, so the macro
# works. Older ones hand the bind the parameter's qualified name instead, so the macro cannot
# be created and the error says what to write. The runner has no per-version directive, so each
# statement allows exactly those two outcomes: the macro is created and forwards the value, or
# the creation fails with the message.

statement maybe
CREATE MACRO bare_table(tbl) AS TABLE
SELECT * FROM read_835('../oxedi_core/tests/samples/edi835_test_eyemed.RMT', table_name := tbl);
----
read_835: table_name must be a constant string; a table macro passed its parameter "tbl" as "0_macro_parametersbare_table.tbl"; this DuckDB version does not substitute a macro parameter given with := or =>, so write table_name = tbl

statement maybe
SELECT CASE WHEN count(*) = 82 THEN 1 ELSE error('bare_table did not forward the table name') END FROM bare_table('claims');
----
Table Function with name bare_table does not exist

statement maybe
SELECT CASE WHEN count(*) = 1 THEN 1 ELSE error('bare_table did not forward the table name') END FROM bare_table('payments');
----
Table Function with name bare_table does not exist

statement maybe
CREATE MACRO bare_version(v) AS TABLE
SELECT * FROM read_835('../oxedi_core/tests/samples/edi835_test_eyemed.RMT', version := v);
----
read_835: version must be a constant string; a table macro passed its parameter "v" as "0_macro_parametersbare_version.v"; this DuckDB version does not substitute a macro parameter given with := or =>, so write version = v

statement maybe
SELECT CASE WHEN count(*) = 82 THEN 1 ELSE error('bare_version did not forward the version') END FROM bare_version('4010');
----
Table Function with name bare_version does not exist

# Writing the argument with = forwards the parameter.

statement ok
CREATE MACRO eq_table(tbl) AS TABLE
SELECT * FROM read_835('../oxedi_core/tests/samples/edi835_test_eyemed.RMT', table_name = tbl);

query I
SELECT count(*) FROM eq_table('claims');
----
82

statement ok
CREATE MACRO eq_version(v) AS TABLE
SELECT * FROM read_835('../oxedi_core/tests/samples/edi835_test_eyemed.RMT', version = v);

query I
SELECT count(*) FROM eq_version('4010');
----
82

# The cast makes the argument an expression, so DuckDB binds it when the macro is called.

statement ok
CREATE MACRO one(tbl) AS TABLE
SELECT * FROM read_835('../oxedi_core/tests/samples/edi835_test_eyemed.RMT', table_name := tbl::VARCHAR);

query I
SELECT count(*) FROM one('claims');
----
82

query I
SELECT count(*) FROM one('payments');
----
1

statement error
SELECT count(*) FROM one('nope');
----
read_835: unknown table "nope"

statement ok
CREATE MACRO pinned(v) AS TABLE
SELECT * FROM read_835('../oxedi_core/tests/samples/edi835_test_eyemed.RMT', version := v::VARCHAR);

query I
SELECT count(*) FROM pinned('4010');
----
82

# With the path as a macro parameter too, the whole call is bound when the macro is called.

statement ok
CREATE MACRO t835(path, tbl) AS TABLE SELECT * FROM read_835(path, table_name := tbl);

query I
SELECT count(*) FROM t835('../oxedi_core/tests/samples/edi835_test_eyemed.RMT', 'services');
----
414

# A literal that happens to start like a macro parameter is still an unknown table.

statement error
SELECT * FROM read_835('../oxedi_core/tests/samples/edi835_test_eyemed.RMT', table_name := '0_macro_parameters');
----
read_835: unknown table "0_macro_parameters"
