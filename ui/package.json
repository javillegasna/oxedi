{
  "name": "@oxedi/ui",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "customElements": "dist/custom-elements.json",
  "scripts": {
    "build": "vite build && tsc -p tsconfig.json && cem analyze --globs src/oxedi-viewer.ts --outdir dist",
    "test": "vitest run",
    "storybook": "storybook dev --no-version-updates",
    "build-storybook": "storybook build -o dist/storybook"
  },
  "dependencies": {
    "lit": "3.3.3"
  },
  "devDependencies": {
    "@custom-elements-manifest/analyzer": "0.11.0",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-vitest": "10.6.7",
    "@storybook/web-components-vite": "10.6.7",
    "@vitest/browser-playwright": "5.1.0",
    "playwright": "1.63.0",
    "storybook": "10.6.7",
    "typescript": "7.0.2",
    "vite": "8.3.7",
    "vitest": "5.1.0"
  }
}
